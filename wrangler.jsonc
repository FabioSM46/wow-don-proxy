{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow-don-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  // Served only on the free workers.dev address; no preview URLs that would expose
  // other versions of the Worker.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Kill switch: set to "false" (dashboard or redeploy) and every request gets 503
    // without reaching CurseForge.
    "PROXY_ENABLED": "true",
    // Global cap on the requests sent to CurseForge per UTC day, across every client. Past it
    // every request gets 503 until 00:00 UTC, so that whoever calls the Worker can never push
    // the key's traffic beyond this volume.
    "DAILY_LIMIT": "30000"
  },
  // Set only with `wrangler secret put CURSEFORGE_API_KEY`, never written in this file.
  "secrets": { "required": ["CURSEFORGE_API_KEY"] },
  "ratelimits": [
    {
      // Per client IP and per Cloudflare location; approximate by design.
      "name": "RATE_LIMITER",
      "namespace_id": "4601",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // The counter behind DAILY_LIMIT: one SQLite-backed Durable Object (the only kind on the
  // free plan).
  "durable_objects": {
    "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // The Worker writes its own log line without query strings or client data.
      "invocation_logs": false
    },
    // Traces never record custom headers such as x-api-key.
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
